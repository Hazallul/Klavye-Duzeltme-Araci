<Project Sdk="Microsoft.NET.Sdk">

  <!-- Bağımlılıksız test/ölçüm aracı: düzeltme motorunu doğrudan derler (arayüz ve klavye kancası olmadan). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Duzeltici\Engine\*.cs" Link="Engine\%(Filename)%(Extension)" />
    <None Include="..\..\src\Duzeltici\Data\*.txt" Link="Data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
